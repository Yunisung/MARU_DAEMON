<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">
	<!-- -Dlogback.configurationFile=logback.xml-->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{15} - %msg%n</pattern>
        </encoder>
    </appender>

 	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender"> 
    	<file>../logs/root.txt</file>
    	<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
    		<fileNamePattern>../logs/root.%d{yyyyMMdd}.zip</fileNamePattern><!-- daily rollover -->
      		<maxHistory>30</maxHistory><!-- keep 30 days' worth of history -->
    	</rollingPolicy>
		<encoder>
      		<pattern>%d{yyyy/MM/dd HH:mm:ss.SSS} %-5level %logger{15} - %msg%n</pattern>
    	</encoder>
	</appender> 
	
	
	<logger name="io.netty" level="INFO"/>
	<logger name="org.apache.commons.beanutils" level="ERROR"/>
	<logger name="org.springframework" level="INFO"/>
	
    <root level="DEBUG">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>

